{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-wushu.local/schemas/paper-deep-review-deliverable-1.8.0.json",
  "title": "Narrative Paper Review Audit Manifest",
  "description": "Audit metadata for a reader-facing narrative Paper review. This schema does not prescribe report headings or prose order. Validation results are generated by the validator, not hand-entered here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deliverable_type", "invocation_mode", "paper", "revision", "artifacts", "source_map", "visuals", "limitations", "publication"],
  "properties": {
    "schema_version": {"const": "1.8.0"},
    "deliverable_type": {"const": "paper-deep-review"},
    "invocation_mode": {"enum": ["standalone", "delegated"]},
    "paper": {
      "type": "object", "additionalProperties": false,
      "required": ["paper_key", "title", "source_version", "paper_url", "tags", "authorship_and_affiliations"],
      "properties": {
        "paper_key": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "source_version": {"type": "string", "minLength": 1},
        "paper_url": {"type": "string", "format": "uri"},
        "tags": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authorship_and_affiliations": {"type": "object", "additionalProperties": false, "required": ["identity_status", "ordered_authors", "first_authors", "corresponding_authors", "role_affiliations", "institutions", "evidence"], "properties": {"identity_status": {"enum": ["personal", "institutional", "anonymous", "not-stated"]}, "ordered_authors": {"type": "array", "items": {"type": "string", "minLength": 1}}, "first_authors": {"type": "array", "items": {"type": "string", "minLength": 1}}, "corresponding_authors": {"type": "array", "items": {"type": "string", "minLength": 1}}, "role_affiliations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "role", "affiliations", "evidence"], "properties": {"name": {"type": "string", "minLength": 1}, "role": {"enum": ["first", "co-first", "corresponding"]}, "affiliations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "evidence": {"type": "string", "minLength": 1}}}}, "institutions": {"type": "array", "items": {"type": "string", "minLength": 1}}, "evidence": {"type": "string", "minLength": 1}}},
        "code_revision": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "document_version", "revised_at", "supersedes_manifest_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "document_version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
        "revised_at": {"type": "string", "format": "date-time"},
        "supersedes_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["analysis", "paper_source", "figure_inventory", "reading_review"],
      "properties": {
        "analysis": {"$ref": "#/$defs/artifact"},
        "paper_source": {"$ref": "#/$defs/artifact"},
        "figure_inventory": {"$ref": "#/$defs/artifact"},
        "reading_review": {"$ref": "#/$defs/artifact"},
        "review_checklist": {"$ref": "#/$defs/artifact"},
        "source_archive": {"$ref": "#/$defs/artifact"},
        "code_snapshot": {"$ref": "#/$defs/artifact"},
        "openreview_reviews": {"$ref": "#/$defs/artifact"},
        "contact_sheet": {"$ref": "#/$defs/artifact"}
      }
    },
    "source_map": {
      "type": "array", "minItems": 1,
      "description": "A small index of consequential claims, not a paragraph-by-paragraph rewrite.",
      "items": {"type": "object", "additionalProperties": false,
        "required": ["report_excerpt", "source_refs", "source_excerpt", "evidence_kind"],
        "properties": {
        "report_excerpt": {"type": "string", "minLength": 20},
          "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
          "source_excerpt": {"type": "string", "minLength": 20},
          "evidence_kind": {"enum": ["paper-stated", "reviewer-inference", "measured", "code-confirmed"]}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_owner", "canonical_path", "promotion_plan_path"],
      "properties": {
        "canonical_owner": {"type": "string", "minLength": 1},
        "canonical_path": {"type": "string", "minLength": 1},
        "promotion_plan_path": {"type": ["string", "null"]}
      }
    },
    "visuals": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["object_id", "path", "supports_excerpt"],
        "properties": {
          "object_id": {"type": "string", "minLength": 2},
          "path": {"type": "string", "minLength": 1},
          "supports_excerpt": {"type": "string", "minLength": 20}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
