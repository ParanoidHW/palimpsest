{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ai-systems/diagram-qa-status.schema.json",
  "title": "AI systems diagram QA coordination status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_id",
    "request_id",
    "review_round",
    "status",
    "updated_at",
    "request",
    "review"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "diagram_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "request_id": {"type": "string", "pattern": "^[0-9]+-[a-f0-9]{12}$"},
    "review_round": {"type": "integer", "minimum": 1},
    "status": {
      "enum": ["pending", "reviewing", "changes-requested", "passed", "error"]
    },
    "updated_at": {"type": "string", "format": "date-time"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_at", "requested_by", "qa_tool", "source", "render", "crops"],
      "properties": {
        "requested_at": {"type": "string", "format": "date-time"},
        "requested_by": {"const": "main-agent"},
        "qa_tool": {"$ref": "#/$defs/artifact"},
        "source": {"$ref": "#/$defs/artifact"},
        "render": {"$ref": "#/$defs/artifact"},
        "crops": {
          "type": "array",
          "items": {"$ref": "#/$defs/crop_artifact"},
          "minItems": 1
        },
        "contract": {
          "oneOf": [
            {"$ref": "#/$defs/artifact"},
            {"type": "null"}
          ]
        },
        "checklist": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewer_role",
        "claimed_at",
        "completed_at",
        "verdict",
        "reviewed_request_id",
        "reviewed_render_sha256",
        "reviewed_crops",
        "findings",
        "summary"
      ],
      "properties": {
        "reviewer": {"type": ["string", "null"]},
        "reviewer_role": {
          "oneOf": [
            {"const": "independent-qa-subagent"},
            {"type": "null"}
          ]
        },
        "claimed_at": {"type": ["string", "null"], "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "verdict": {
          "oneOf": [
            {"enum": ["changes-requested", "passed", "error"]},
            {"type": "null"}
          ]
        },
        "reviewed_request_id": {"type": ["string", "null"]},
        "reviewed_render_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewed_crops": {
          "type": "array",
          "items": {"$ref": "#/$defs/crop_artifact"}
        },
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        },
        "summary": {"type": "string"}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "crop_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "region"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "region": {
          "enum": [
            "main-flow",
            "communication",
            "cross-rank-return",
            "ownership-time",
            "legend-footer",
            "other"
          ]
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "region", "description", "resolved"],
      "properties": {
        "severity": {"enum": ["blocker", "major", "minor", "note"]},
        "region": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "resolved": {"type": "boolean"}
      }
    }
  }
}
