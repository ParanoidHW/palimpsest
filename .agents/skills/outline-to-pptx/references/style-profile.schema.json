{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/outline-to-pptx/style-profile.schema.json",
  "title": "Outline to PPTX style profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "theme_family",
    "canvas",
    "fonts",
    "typography",
    "palette",
    "emphasis",
    "content",
    "navigation",
    "layout",
    "qa"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "theme_family": {
      "const": "academic-editorial-light"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_in", "height_in", "light_background_required", "dark_slides_allowed"],
      "properties": {
        "width_in": {"type": "number", "const": 17.7778},
        "height_in": {"type": "number", "const": 10},
        "light_background_required": {"const": true},
        "dark_slides_allowed": {"type": "boolean"}
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh_primary", "en_primary", "fallback"],
      "properties": {
        "zh_primary": {"type": "string", "minLength": 1},
        "en_primary": {"type": "string", "minLength": 1},
        "fallback": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizes_pt", "max_distinct_sizes_per_slide", "body_min_pt", "large_metric_reuses"],
      "properties": {
        "sizes_pt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "body", "note"],
          "properties": {
            "title": {"type": "integer", "minimum": 28, "maximum": 44},
            "body": {"type": "integer", "minimum": 14, "maximum": 22},
            "note": {"type": "integer", "minimum": 9, "maximum": 12}
          }
        },
        "max_distinct_sizes_per_slide": {"type": "integer", "const": 3},
        "body_min_pt": {"type": "integer", "minimum": 14},
        "large_metric_reuses": {"enum": ["title", "body"]}
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canvas", "ink", "body", "muted", "line", "soft", "critical_red", "white"],
      "properties": {
        "canvas": {"$ref": "#/$defs/hex"},
        "ink": {"$ref": "#/$defs/hex"},
        "body": {"$ref": "#/$defs/hex"},
        "muted": {"$ref": "#/$defs/hex"},
        "line": {"$ref": "#/$defs/hex"},
        "soft": {"$ref": "#/$defs/hex"},
        "critical_red": {"$ref": "#/$defs/hex"},
        "white": {"$ref": "#/$defs/hex"}
      }
    },
    "emphasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_requires_bold", "critical_color_token", "max_fragments_per_slide", "whole_paragraph_red_allowed"],
      "properties": {
        "critical_requires_bold": {"const": true},
        "critical_color_token": {"const": "critical_red"},
        "max_fragments_per_slide": {"type": "integer", "minimum": 1, "maximum": 3},
        "whole_paragraph_red_allowed": {"const": false}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title_mode", "max_title_chars", "max_message_groups_per_slide", "information_density"],
      "properties": {
        "title_mode": {"const": "viewpoint"},
        "max_title_chars": {"type": "integer", "minimum": 18, "maximum": 40},
        "max_message_groups_per_slide": {"type": "integer", "const": 3},
        "information_density": {"const": "high"}
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "standalone_agenda_slides", "repeated_section_dividers"],
      "properties": {
        "mode": {"const": "running-header"},
        "standalone_agenda_slides": {"const": false},
        "repeated_section_dividers": {"const": false}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outer_margin_in", "columns", "max_major_columns", "cards_default"],
      "properties": {
        "outer_margin_in": {"type": "number", "minimum": 0.9, "maximum": 1.3},
        "columns": {"type": "integer", "const": 12},
        "max_major_columns": {"type": "integer", "minimum": 1, "maximum": 2},
        "cards_default": {"const": false}
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_renderer", "libreoffice_role", "require_second_render_after_fix"],
      "properties": {
        "primary_renderer": {"const": "microsoft-powerpoint"},
        "libreoffice_role": {"const": "secondary-compatibility-only"},
        "require_second_render_after_fix": {"const": true}
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^[0-9A-F]{6}$"
    }
  }
}
