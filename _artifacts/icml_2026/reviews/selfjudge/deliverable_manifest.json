    {"design": "Suffix-aware semantic score", "rationale_status": "author-stated", "rationale_sources": ["paper Eq.(6-8)"], "concrete_problem": "Prefix-only probabilities and answer-specific labels miss contextual equivalence.", "causal_mechanism": "Future-token likelihood supplies evidence for replacement consistency.", "analysis_basis": ["analysis.md §3.2", "analysis.md §3.4"], "alternatives_tradeoffs": "NLI or LLM judges add cost and external bias.", "validation_evidence": {"type": "sensitivity", "sources": ["paper Figure 4"], "judgment": "partially-supported"}},
    {"design": "Suffix length N=20", "rationale_status": "author-stated", "rationale_sources": ["paper §4.1", "paper Figure 4"], "concrete_problem": "N=0 lacks future context.", "causal_mechanism": "Longer suffix improves evidence for semantic consistency.", "analysis_basis": ["analysis.md §3.2"], "alternatives_tradeoffs": "Longer N costs more partial-prefill compute.", "validation_evidence": {"type": "sensitivity", "sources": ["paper Figure 4"], "judgment": "supported"}},
    {"design": "Logistic regression verifier", "rationale_status": "author-stated", "rationale_sources": ["paper §3.4"], "concrete_problem": "Online verification must have negligible overhead.", "causal_mechanism": "Linear classification over existing target hidden state avoids another deep model.", "analysis_basis": ["analysis.md §3.2", "analysis.md §7.1"], "alternatives_tradeoffs": "MLP or transformer may improve capacity but increase latency.", "validation_evidence": {"type": "indirect", "sources": ["paper §4.5 elapsed-time analysis"], "judgment": "plausible"}},
    {"design": "Tau from 0.1 quantile of AutoJudge unacceptable scores", "rationale_status": "author-stated", "rationale_sources": ["paper §4.1"], "concrete_problem": "Answer-critical replacements must be rejected.", "causal_mechanism": "Conservative calibration raises recall for unacceptable tokens.", "analysis_basis": ["analysis.md §3.2"], "alternatives_tradeoffs": "Independent per-domain calibration reduces GSM8K bias.", "validation_evidence": {"type": "indirect", "sources": ["paper Table 1"], "judgment": "partially-supported"}},
    {"design": "Judge and alignment OR acceptance", "rationale_status": "author-stated", "rationale_sources": ["paper §3.2", "paper Appendix D.2"], "concrete_problem": "Alignment over-rejects while judge may falsely reject.", "causal_mechanism": "Union preserves alignment approvals and recovers semantic mismatches.", "analysis_basis": ["analysis.md §3.2", "analysis.md §4.3"], "alternatives_tradeoffs": "Judge-only loses accepted length; OR relaxes strict distribution equivalence.", "validation_evidence": {"type": "direct-ablation", "sources": ["paper Appendix Table 9"], "judgment": "supported"}},
    {"design": "One verifier across tasks", "rationale_status": "author-stated", "rationale_sources": ["paper §3.4"], "concrete_problem": "Per-task verifier training and deployment are expensive.", "causal_mechanism": "Shared target hidden-state semantics may transfer across domains.", "analysis_basis": ["analysis.md §3.2"], "alternatives_tradeoffs": "Task-specific verifiers may be more accurate but less scalable.", "validation_evidence": {"type": "indirect", "sources": ["paper Tables 1,6,7"], "judgment": "partially-supported"}}
