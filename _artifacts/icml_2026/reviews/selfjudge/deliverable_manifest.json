    "document_path": "analysis.md",
    "section_heading": "0.1 术语与符号解释",
    "terms": [
      {"term": "speculative decoding", "definition": "Draft proposes gamma tokens and target verifies them in parallel.", "aliases": ["SD"], "sources": ["analysis.md §0.1", "paper §3.1"], "ambiguity_notes": "Not standalone target greedy decoding."},
      {"term": "target model", "definition": "Large model whose response quality is the reference and which supplies likelihoods and hidden states.", "aliases": ["M_target"], "sources": ["analysis.md §0.1", "paper §3.1"], "ambiguity_notes": "Also labels data but is not the verifier."},
      {"term": "draft model", "definition": "Smaller model proposing candidate tokens and probabilities.", "aliases": ["M_draft"], "sources": ["analysis.md §0.1", "paper §3.1"], "ambiguity_notes": "Distinct from judge verifier."},
      {"term": "alignment verification", "definition": "Rejection-sampling path based on target/draft probability ratio.", "aliases": ["standard SD"], "sources": ["analysis.md §0.1", "paper Eq.(3)"], "ambiguity_notes": "Distributional path, not semantic judge."},
      {"term": "judge verification", "definition": "Online classifier over target hidden state.", "aliases": ["judge decoding"], "sources": ["analysis.md §0.1", "paper §3.2"], "ambiguity_notes": "Does not observe suffix tokens online."},
      {"term": "semantic preservation score", "definition": "Offline target log-likelihood difference between substituted and original response.", "aliases": ["s(y,z_i)"], "sources": ["analysis.md §0.1", "paper Eq.(6-8)"], "ambiguity_notes": "A target-model proxy, not external semantic truth."},
      {"term": "SelfJudge-R / SelfJudge-F", "definition": "Recall-optimal and F1-optimal online threshold operating points.", "aliases": ["R", "F"], "sources": ["analysis.md §0.1", "paper §4.2"], "ambiguity_notes": "Not different verifier capacities."},
      {"term": "two-stage verification", "definition": "Judge and alignment paths run together with OR acceptance.", "aliases": ["SelfJudge inference"], "sources": ["analysis.md §0.1", "paper §3.2"], "ambiguity_notes": "Strict target distribution equivalence only belongs to alignment path."},
      {"term": "suffix window", "definition": "Number of future response tokens included in offline score.", "aliases": ["N"], "sources": ["analysis.md §0.1", "paper Figure 4"], "ambiguity_notes": "Unavailable to online verifier."}
    ],
